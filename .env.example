# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no Git

# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA_AQUI

# development | production
FLASK_ENV=development

# Ativar logs detalhados em desenvolvimento
FLASK_DEBUG=true

# Caminho para o JSON gerado pela V1
# Padrão: ../pp_colaboradores/saida/dados_dashboard.json
# DADOS_JSON_PATH=/caminho/absoluto/dados_dashboard.json

# Caminho para o banco SQLite
# Padrão: ./data/usuarios.db
# DB_PATH=/caminho/absoluto/usuarios.db

# Porta (Render define PORT automaticamente)
PORT=5000
